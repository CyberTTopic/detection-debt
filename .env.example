# Copy to .env.local and fill in. Never commit .env.local.

# --- Studio and import scripts ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Project-level token with Editor permissions. Used ONLY by the import scripts.
SANITY_WRITE_TOKEN=

# --- Sanity Context (the agent reads through these) ---
# ORGANIZATION-level token with Context Viewer permissions.
# Manage > API > Tokens at the ORGANIZATION level, not the project level.
# A project token returns 403 contextGrantRequired.
SANITY_ORGANIZATION_TOKEN=
SANITY_ORGANIZATION_ID=

# https://api.sanity.io/v1/context/organizations/$SANITY_ORGANIZATION_ID/mcp/$ENDPOINT_NAME
SANITY_CONTEXT_GROQ_URL=
SANITY_CONTEXT_KB_URL=

# --- Model: set ANY ONE of these three ---
# The agent in agent/ reads this file from the repository root rather than
# keeping its own copy, so the live tokens exist in exactly one place.
#
# The provider is configuration, not a dependency. Whichever key is present is
# the one used; the prompt and the tools are identical either way. This is here
# because during the build the account holding the only key was revoked, and a
# submission deadline should not rest on one vendor account staying healthy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Force one when several keys are set: anthropic | openai | google
AGENT_PROVIDER=
# Optional. Overrides the provider's default model.
AGENT_MODEL=

# --- Import tuning ---
MAX_RULES=40

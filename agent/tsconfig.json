{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // react-jsx, not preserve: Next uses the automatic runtime and rewrites this
    // on first build anyway. Set here so `npm run typecheck` agrees with it.
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    // The library modules are imported with explicit .ts extensions so the same
    // files run two ways: bundled by Next, and executed directly by
    // `node --experimental-strip-types` for the unit tests. Node's strip-only
    // mode does no resolution, so it requires the real extension; this flag is
    // what lets tsc and Turbopack accept it too.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
